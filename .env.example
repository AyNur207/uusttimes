# Set these in your shell before starting Flask.
# Optional: a long random secret for signed sessions.
# If empty, local development creates instance/.secret_key and reuses it.
SECRET_KEY=
# Public HTTPS donation link copied from your payment service (e.g. CloudTips).
# Never put a card number, CVV, password, or dashboard URL here.
# Leave empty to show the "coming soon" state on /support.
DONATION_URL=
