# Copy this file to .env. Flask reads .env automatically on startup.
# Shell environment variables take precedence over this file.
# Optional: a long random secret for signed sessions.
# If empty, local development creates instance/.secret_key and reuses it.
SECRET_KEY=
# Public HTTPS donation link copied from your payment service (e.g. CloudTips).
# Never put a card number, CVV, password, or dashboard URL here.
# Leave empty to show the "coming soon" state on /support.
DONATION_URL=
# Optional PostgreSQL URL. Empty uses instance/uusttimes.sqlite3 locally.
DATABASE_URL=
# Optional administrator bootstrap. Both values are needed; password >= 8 chars.
# Existing accounts are not modified; use flask create-admin to promote one.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional local image cache directory. Image bytes are also stored in the DB.
UPLOAD_FOLDER=
